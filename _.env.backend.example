# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (no wildcards in production)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ---- Database (Neon Postgres) ----
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/kulago?sslmode=require"

# ---- Auth ----
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=your-backend-domain.vercel.app

# ---- M-Pesa Daraja ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-backend-domain.vercel.app/api/payments/mpesa/callback

# ---- SMS (Africa's Talking) ----
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- Email (SMTP-ready) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KulaGo <no-reply@kulago.co.ke>"

# ---- Misc ----
PAYMENT_TIMEOUT_MINUTES=10
# Shared secret for /api/internal/jobs/*. If you deploy on Vercel and set
# this as CRON_SECRET in the Vercel dashboard, Vercel Cron (see vercel.json)
# sends it automatically as an Authorization: Bearer header — no extra setup
# needed. Name it INTERNAL_JOB_SECRET here either way; the value must match
# whatever your scheduler sends.
INTERNAL_JOB_SECRET=replace_with_another_long_random_string
