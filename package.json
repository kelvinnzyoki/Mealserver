{
  "name": "Mpishi254-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mpishi254 — Kenyan food delivery platform API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npx prisma generate --schema=./prisma/schema.prisma && npx tsc",
    "vercel-build": "npx prisma generate --schema=./prisma/schema.prisma && (npx prisma migrate resolve --rolled-back 20260349000000_add_missing_table5 --schema=./prisma/schema.prisma 2>/dev/null || true) && npx prisma migrate deploy --schema=./prisma/schema.prisma && npx tsc",
    "postinstall": "npx prisma generate --schema=./prisma/schema.prisma",
    "buildCommand": "null",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "jobs:expire-orders": "ts-node src/jobs/expireStaleOrders.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.16.5",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "engines": { "node": ">=20" }
}
